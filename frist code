#include <iostream>
using namespace std;

class node { 
public :
  int val;
  node* next; 
  node (int val ) {
    this->val = val;
  }
}; 
int main () {
  node a(5);
  node b(2);
  node c(1);
  node d(7); 

  // attaching nodes
  a.next = &b;
  b.next = &c;
  d.next = NULL; 

  cout<< (a.next)->val <<endl;
}
